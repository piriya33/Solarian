# =========================================================
# SOLARIAN PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================

# Google Gemini API Key for Server-side AI Life Counselor
# Get one at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Primary Administrator Email
# When this user registers, they are automatically granted role="admin" and tier="pro"
ADMIN_EMAIL=admin@solarian.space

# Secret key for signing JWT authentication tokens
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_secure_random_hex_key_here

# AES-256 Fernet Encryption Key for Birth Data at rest (Optional)
# If left blank, Solarian automatically creates and preserves a .secret_key file
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOLARIAN_ENCRYPTION_KEY=

# Port mapping (Default: 8000)
PORT=8000
